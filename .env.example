# Copy this file to .env and fill in your values. Never commit .env.
# Neither value is needed to run the notebooks.

# Optional: only needed beyond the OpenDota free tier (scripts/opendota_matches.py, scripts/opendota_sample.py)
OPENDOTA_API_KEY=

# Only for scripts/opendota_sample.py: a long random string used to pseudonymize player IDs.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# Keep it private and never change it, or the same player gets a new code.
ANON_SALT=
